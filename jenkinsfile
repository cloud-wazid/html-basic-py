pipeline {
    agent any
    stages {
        stage('Start') {
            steps {
                echo 'welcome to jenkins file'
            }
        }
        
        stage('Build') {
            steps {
                echo 'Build the application....'
            }
        }
        stage('Test') {
            steps {
                echo 'Test the application....'
            }
        }
        stage('deploy') {
            steps {
                echo 'deploy the application...'
            }
        }
            
        }
        
}